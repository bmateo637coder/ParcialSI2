# =====================================================
# FashionStore API - Configuración
# =====================================================
# Copia este archivo a .env para entorno local.
# En el proveedor de despliegue define estas variables desde su panel.
# Para Vercel + Neon, usa la conexión POOLED de Neon con sslmode=require.

# Nombre y versión del proyecto
PROJECT_NAME="FashionStore API"
PROJECT_VERSION="2.0.0"

# Base de datos
# PostgreSQL (producción/examen):
DATABASE_URL="postgresql+psycopg2://usuario:password@localhost:5432/fashionstore"
# SQLite (desarrollo sin PostgreSQL):
# DATABASE_URL="sqlite:///./fashionstore.db"
#
# Ejemplo de conexión externa (no colocar credenciales reales en este archivo):
# DATABASE_URL="postgresql://usuario:password@servidor.neon.tech/fashionstore?sslmode=require"
# En Vercel configura AUTO_INIT_DB=false. En local el esquema se prepara
# automáticamente; las migraciones remotas se ejecutan con deploy.py.
# AUTO_INIT_DB=false

# Seguridad - ¡CAMBIA ESTA CLAVE EN PRODUCCIÓN!
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-secret-key-no-usar-en-produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=600

# Orígenes permitidos (CORS), como lista JSON.
# Incluye la URL HTTPS real del frontend desplegado, por ejemplo:
#   ["https://mi-fashionstore.vercel.app"]
# Si usas ["*"], las credenciales se desactivan automáticamente.
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Siembra los datos demo al arrancar (AUTO_SEED=true para una demostración).
# Actívalo solo para una demostración inicial: también restablece usuarios demo.
# Para conservar usuarios y contraseñas, déjalo desactivado en el despliegue.
AUTO_SEED=false

# Opcional: narrativa generativa de reportes por voz (Gemini).
# Si está vacío se usa la plantilla local en español.
GENAI_API_KEY=""

EXCHANGE_WINDOW_DAYS=15
ALLOW_DEMO_PASSWORD_RESET=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_STARTTLS=true
FRONTEND_URL="http://localhost:4200"
