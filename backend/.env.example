# =====================================================
# FashionStore API - Configuración
# =====================================================

# Nombre y versión del proyecto
PROJECT_NAME="FashionStore API"
PROJECT_VERSION="2.0.0"

# Base de datos
# SQLite (por defecto, sin configuración adicional):
DATABASE_URL="sqlite:///./fashionstore.db"
# PostgreSQL (producción):
# DATABASE_URL="postgresql://usuario:password@localhost:5432/fashionstore"

# Seguridad - ¡CAMBIA ESTA CLAVE EN PRODUCCIÓN!
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-secret-key-no-usar-en-produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=600

# Orígenes permitidos (CORS). Sepáralos con comas si hay varios.
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]