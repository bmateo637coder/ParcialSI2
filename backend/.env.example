# =====================================================
# FashionStore API - Configuración
# =====================================================
# Copia este archivo a .env para entorno local.
# En Railway NO uses .env: define estas variables en el dashboard
# (Deploy > Variables). DATABASE_URL y PORT los pone Railway solo.

# Nombre y versión del proyecto
PROJECT_NAME="FashionStore API"
PROJECT_VERSION="2.0.0"

# Base de datos
# PostgreSQL (producción/examen):
DATABASE_URL="postgresql+psycopg2://usuario:password@localhost:5432/fashionstore"
# SQLite (desarrollo sin PostgreSQL):
# DATABASE_URL="sqlite:///./fashionstore.db"
#
# Railway inyecta DATABASE_URL automáticamente con formato
# "postgres://usuario:password@host:puerto/railway". La API lo normaliza,
# así que no hace falta tocarlo.

# Seguridad - ¡CAMBIA ESTA CLAVE EN PRODUCCIÓN!
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev-secret-key-no-usar-en-produccion"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=600

# Orígenes permitidos (CORS). Sepáralos con comas si hay varios.
# En Railway incluye la URL del frontend desplegado, por ejemplo:
#   ["https://frontend.up.railway.app","http://localhost:4200"]
# Si usas ["*"], las credenciales se desactivan automáticamente.
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Siembra los datos demo al arrancar (en Railway pon AUTO_SEED=true la 1ª vez).
# El seed es idempotente: se puede dejar en true siempre sin dañar datos.
AUTO_SEED=false

# Opcional: narrativa generativa de reportes por voz (Gemini).
# Si está vacío se usa la plantilla local en español.
GENAI_API_KEY=""